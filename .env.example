# Copy to .env.local and fill in. Never commit a real .env file.
#
# EXPO_PUBLIC_* variables are embedded in the JS bundle IN PLAINTEXT.
# They are for base URLs and feature flags ONLY.
# No secret, key, credential or token may ever be an EXPO_PUBLIC_ variable.

# development | staging | production
APP_ENV=development

# TODO(backend-contract): no backend exists yet and no environment list has been provided.
# The app fails fast at startup while this is empty — that is intentional.
EXPO_PUBLIC_API_BASE_URL=

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# debug | info | warn | error | silent
EXPO_PUBLIC_LOG_LEVEL=debug
