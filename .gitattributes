# Normalise line endings.
#
# .prettierrc sets `endOfLine: "lf"`, so a checkout that produced CRLF would make
# `prettier --check .` fail on a fresh clone even though nothing is wrong with the code.
# Pinning text files to LF in the working tree keeps the formatting gate reproducible on
# Windows, macOS and CI alike, regardless of each developer's core.autocrlf setting.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.ico binary
*.jks binary
*.keystore binary

# patch-package diffs. A unified diff encodes a BLANK context line as a single space, so
# `git diff --check` reports every one as trailing whitespace. Stripping them corrupts the
# patch and breaks `postinstall`. Exempt them from the whitespace check rather than let a
# well-meaning cleanup silently take the Android build down.
*.patch -whitespace
