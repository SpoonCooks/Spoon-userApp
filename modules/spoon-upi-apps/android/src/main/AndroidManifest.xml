<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Android 11+ package visibility: without this, queryIntentActivities sees no UPI app at all.
    Merged into the app's manifest, so no generated file is edited.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="upi" />
    </intent>
  </queries>
</manifest>
